{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "kreasisatudesain",
  "compatibility_date": "2026-10-05",
  "main": "./dist/_worker.js",
  "assets": { "directory": "./dist", "binding": "ASSETS" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ksd-portfolio",
      "database_id": "5e16e181-00a0-46f1-8c22-fc95050dd54d"
    }
  ],
  "r2_buckets": [
    {
      "binding": "R2",
      "bucket_name": "ksd-portfolio-images"
    }
  ]
}
