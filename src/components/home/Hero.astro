---
import { companyData } from "@/data/company";
---

<section class="relative min-h-screen flex items-center justify-center overflow-hidden bg-stone-900 text-white">
  {/* Background Video */}
  <div class="absolute inset-0 z-0">
    <video
      autoplay
      muted
      loop
      playsinline
      preload="auto"
      poster="/images/hero/section-1-web-rev@2x.webp"
      class="h-full w-full object-cover object-center"
    >
      <source src="/videos/hero-video.mp4" type="video/mp4" />
    </video>
    {/* Multi-layer overlay for cinematic depth */}
    <div class="absolute inset-0 bg-gradient-to-b from-stone-900/60 via-stone-900/40 to-stone-900/90"></div>
    <div class="absolute inset-0 bg-gradient-to-r from-stone-900/30 via-transparent to-stone-900/30"></div>
  </div>

  <div class="relative z-10 w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center py-20 lg:py-28">
    
    {/* Main Headline - Unica One Font, Responsive Layout */}
    <div class="hero-fade-in w-full max-w-6xl mx-auto mb-10 sm:mb-14">
      <h1 class="font-unica font-normal tracking-wide text-white">
        {/* Desktop Layout (sm and up): 2 baris terpusat (center-align) */}
        <span class="hidden sm:flex flex-col items-center text-4xl sm:text-5xl md:text-6xl lg:text-7xl xl:text-[5.25rem] leading-[1.1] text-center">
          <span class="whitespace-nowrap">Membangun Harmoni,</span>
          <span class="whitespace-nowrap">Menciptakan Ruang Bermakna</span>
        </span>

        {/* Mobile Layout (< sm): 1 kata per baris, rata kiri (left-align) */}
        <span class="flex sm:hidden flex-col items-start text-5xl xs:text-6xl leading-[1.1] text-left">
          <span>Membangun</span>
          <span>Harmoni,</span>
          <span>Menciptakan</span>
          <span>Ruang</span>
          <span>Bermakna</span>
        </span>
      </h1>
    </div>

    {/* Trust Points — 3 Items horizontal on both Mobile & Desktop */}
    <div class="hero-fade-in-delay-1 grid grid-cols-3 gap-2 xs:gap-4 sm:gap-8 max-w-3xl mx-auto mb-12 sm:mb-14 px-1 sm:px-0">
      <div class="flex flex-col items-center gap-2 sm:gap-3 text-center">
        <div class="flex h-11 w-11 sm:h-14 sm:w-14 items-center justify-center rounded-xl sm:rounded-2xl bg-white/5 backdrop-blur-md border border-white/10 shadow-xl">
          <svg class="w-5 h-5 sm:w-7 sm:h-7 text-stone-200" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z" />
          </svg>
        </div>
        <span class="text-xs sm:text-base text-stone-300 font-medium tracking-tight sm:tracking-wide">Desain Presisi</span>
      </div>

      <div class="flex flex-col items-center gap-2 sm:gap-3 text-center">
        <div class="flex h-11 w-11 sm:h-14 sm:w-14 items-center justify-center rounded-xl sm:rounded-2xl bg-white/5 backdrop-blur-md border border-white/10 shadow-xl">
          <svg class="w-5 h-5 sm:w-7 sm:h-7 text-stone-200" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 0 0-9-9Z" />
          </svg>
        </div>
        <span class="text-xs sm:text-base text-stone-300 font-medium tracking-tight sm:tracking-wide">RAB Transparan</span>
      </div>

      <div class="flex flex-col items-center gap-2 sm:gap-3 text-center">
        <div class="flex h-11 w-11 sm:h-14 sm:w-14 items-center justify-center rounded-xl sm:rounded-2xl bg-white/5 backdrop-blur-md border border-white/10 shadow-xl">
          <svg class="w-5 h-5 sm:w-7 sm:h-7 text-stone-200" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 0 1 0-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178Z" />
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
          </svg>
        </div>
        <span class="text-xs sm:text-base text-stone-300 font-medium tracking-tight sm:tracking-wide">Pengawasan Penuh</span>
      </div>
    </div>

    {/* Primary CTA Button */}
    <div class="hero-fade-in-delay-2 flex items-center justify-center max-w-xs mx-auto">
      <a
        href="#portofolio"
        class="group w-full inline-flex items-center justify-center gap-2 rounded-xl bg-white/15 border border-white/25 backdrop-blur-md px-8 py-4 text-sm sm:text-base font-semibold text-white hover:bg-white/25 hover:border-white/40 transition-all duration-300 shadow-xl hover:scale-[1.02] active:scale-98"
      >
        Lihat Portofolio
        <svg class="w-4 h-4 transition-transform duration-300 group-hover:translate-x-1" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M17.25 8.25 21 12m0 0-3.75 3.75M21 12H3" />
        </svg>
      </a>
    </div>
  </div>
</section>

<style>
  /* Import Google Font Unica One */
  @import url('https://fonts.googleapis.com/css2?family=Unica+One&display=swap');

  .font-unica {
    font-family: 'Unica One', system-ui, sans-serif;
    text-transform: uppercase;
  }

  /* Unified fadeInUp animations for all elements */
  .hero-fade-in {
    opacity: 0;
    animation: fadeInUp 0.8s ease-out 0.2s forwards;
  }
  .hero-fade-in-delay-1 {
    opacity: 0;
    animation: fadeInUp 0.8s ease-out 0.4s forwards;
  }
  .hero-fade-in-delay-2 {
    opacity: 0;
    animation: fadeInUp 0.8s ease-out 0.6s forwards;
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
