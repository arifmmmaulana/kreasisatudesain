---
import { companyData } from "@/data/company";
import { getWhatsAppUrl } from "@/lib/whatsapp";

const waUrl = getWhatsAppUrl("Halo Kreasi Satu Desain, saya ingin berdiskusi mengenai proyek desain/bangun rumah.");
---

<section class="py-24 bg-brand-dark text-white relative overflow-hidden">
  <div class="relative z-10 max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    <h2 class="text-3xl sm:text-5xl font-bold font-display tracking-tight text-white mb-8 leading-tight">
      Siap Mewujudkan Hunian Impian Anda?
    </h2>

    {/* CTA Buttons */}
    <div class="flex flex-col sm:flex-row items-center justify-center gap-4 max-w-lg mx-auto">
      <a
        href={waUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="w-full sm:w-auto inline-flex items-center justify-center rounded-xl bg-emerald-600 px-9 py-4 text-base font-bold text-white shadow-xl hover:bg-emerald-500 transition-all duration-300 active:scale-95"
      >
        Chat WhatsApp Langsung
      </a>

      <a
        href={`tel:${companyData.contact.whatsapp}`}
        class="w-full sm:w-auto inline-flex items-center justify-center rounded-xl bg-white/10 border border-white/20 px-6 py-4 text-sm font-semibold text-white hover:bg-white/20 transition"
      >
        {companyData.contact.phone}
      </a>
    </div>
  </div>
</section>
