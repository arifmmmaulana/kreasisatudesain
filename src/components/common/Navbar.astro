---
interface Props {
  currentPath?: string;
  transparent?: boolean;
}

const { currentPath = "/", transparent = false } = Astro.props;
---

<header
  id="main-navbar"
  class="fixed top-0 left-0 right-0 z-40 transition-all duration-300 bg-white/90 backdrop-blur-md border-b border-stone-200/80 shadow-xs"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20">
      {/* Brand Logo */}
      <a href="/" class="flex items-center gap-3 group">
        <img
          src="/images/branding/ksd-header-logo.webp"
          alt="Kreasi Satu Desain Logo"
          class="h-10 sm:h-12 w-auto object-contain transition-transform duration-200 group-hover:scale-105"
          decoding="async"
        />
      </a>

      {/* Desktop Navigation */}
      <nav class="hidden md:flex items-center gap-8">
        <a
          href="/"
          class={`text-sm font-semibold tracking-wide transition-colors ${
            currentPath === "/"
              ? "text-brand-dark font-bold border-b-2 border-brand pb-1"
              : "text-stone-700 hover:text-brand-dark"
          }`}
        >
          Beranda
        </a>
        <a
          href="/about"
          class={`text-sm font-semibold tracking-wide transition-colors ${
            currentPath === "/about"
              ? "text-brand-dark font-bold border-b-2 border-brand pb-1"
              : "text-stone-700 hover:text-brand-dark"
          }`}
        >
          About Us
        </a>
      </nav>

      {/* Mobile Menu Toggle Button */}
      <div class="flex md:hidden">
        <button
          type="button"
          id="mobile-menu-btn"
          class="inline-flex items-center justify-center p-2 rounded-lg text-stone-700 hover:text-stone-900 hover:bg-stone-100 focus:outline-none cursor-pointer"
          aria-expanded="false"
          aria-label="Buka menu navigasi"
        >
          <svg id="icon-menu" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <svg id="icon-close" class="h-6 w-6 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  {/* Mobile Menu Dropdown */}
  <div id="mobile-menu" class="hidden md:hidden border-b border-stone-200 bg-white px-4 pt-3 pb-6 space-y-3 shadow-lg">
    <a
      href="/"
      class={`block rounded-lg px-3 py-2 text-base font-semibold ${
        currentPath === "/" ? "bg-brand-light text-brand-dark" : "text-stone-800 hover:bg-stone-100"
      }`}
    >
      Beranda
    </a>
    <a
      href="/about"
      class={`block rounded-lg px-3 py-2 text-base font-semibold ${
        currentPath === "/about" ? "bg-brand-light text-brand-dark" : "text-stone-800 hover:bg-stone-100"
      }`}
    >
      About Us
    </a>
  </div>
</header>

<script>
  const btn = document.getElementById("mobile-menu-btn");
  const menu = document.getElementById("mobile-menu");
  const iconMenu = document.getElementById("icon-menu");
  const iconClose = document.getElementById("icon-close");

  btn?.addEventListener("click", () => {
    const isHidden = menu?.classList.contains("hidden");
    if (isHidden) {
      menu?.classList.remove("hidden");
      iconMenu?.classList.add("hidden");
      iconClose?.classList.remove("hidden");
    } else {
      menu?.classList.add("hidden");
      iconMenu?.classList.remove("hidden");
      iconClose?.classList.add("hidden");
    }
  });
</script>
