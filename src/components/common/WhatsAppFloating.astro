---
import { getWhatsAppUrl } from "@/lib/whatsapp";

const quickMessages = [
  {
    label: "Konsultasi Desain Rumah Baru",
    text: "Halo Kreasi Satu Desain, saya ingin konsultasi mengenai desain rumah tinggal baru.",
  },
  {
    label: "Jasa Konstruksi / Bangun Rumah",
    text: "Halo, saya ingin menanyakan estimasi biaya dan tahapan konstruksi bangun rumah.",
  },
  {
    label: "Renovasi Rumah / Komersial",
    text: "Halo Kreasi Satu Desain, saya berencana melakukan renovasi properti saya.",
  },
];

const directWaUrl = getWhatsAppUrl();
---

<div id="wa-floating-container" class="fixed bottom-6 right-6 z-50 flex flex-col items-end pointer-events-auto">
  {/* Quick Chat Popup */}
  <div
    id="wa-popup"
    class="hidden mb-3 w-80 sm:w-96 rounded-2xl bg-white p-5 shadow-2xl border border-stone-200 transition-all duration-300 origin-bottom-right"
    role="dialog"
    aria-label="Konsultasi WhatsApp"
  >
    {/* Popup Header */}
    <div class="flex items-center justify-between border-b border-stone-100 pb-3">
      <div class="flex items-center gap-3">
        <div class="flex h-10 w-10 items-center justify-center rounded-full bg-emerald-600 text-white font-bold text-xs shadow-xs">
          KSD
        </div>
        <div>
          <h4 class="text-sm font-bold text-stone-900">Kreasi Satu Desain</h4>
          <p class="text-xs text-stone-500 font-medium">
            Siap Konsultasi
          </p>
        </div>
      </div>
      <button
        type="button"
        id="wa-close-btn"
        class="rounded-full p-1.5 text-stone-400 hover:bg-stone-100 hover:text-stone-700 transition cursor-pointer"
        aria-label="Tutup popup"
      >
        <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    {/* Greeting text */}
    <div class="my-4 rounded-xl bg-stone-50 p-3 text-xs text-stone-600 leading-relaxed border border-stone-100">
      Halo! Selamat datang di <strong>Kreasi Satu Desain</strong>. Ada yang bisa kami bantu?
    </div>

    {/* Topic Options */}
    <div class="space-y-2">
      <p class="text-[11px] font-semibold uppercase tracking-wider text-stone-400">
        Pilih Topik Konsultasi:
      </p>
      {quickMessages.map((item) => (
        <a
          href={getWhatsAppUrl(item.text)}
          target="_blank"
          rel="noopener noreferrer"
          class="group flex items-center justify-between rounded-lg border border-stone-200 p-2.5 text-xs font-medium text-stone-800 hover:border-emerald-500 hover:bg-emerald-50/50 hover:text-emerald-700 transition"
        >
          <span>{item.label}</span>
          <svg class="h-3.5 w-3.5 text-stone-400 group-hover:text-emerald-600 group-hover:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
          </svg>
        </a>
      ))}
    </div>

    {/* Direct Action Button */}
    <div class="mt-4 pt-3 border-t border-stone-100">
      <a
        href={directWaUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="flex w-full items-center justify-center gap-2 rounded-xl bg-emerald-600 px-4 py-2.5 text-xs font-semibold text-white hover:bg-emerald-500 transition shadow-sm active:scale-98"
      >
        <span>Chat WhatsApp Langsung</span>
        <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
        </svg>
      </a>
    </div>
  </div>

  {/* Floating Main Toggle Button */}
  <button
    type="button"
    id="wa-toggle-btn"
    class="group relative flex h-14 items-center gap-3 rounded-full bg-emerald-600 px-5 text-white shadow-xl shadow-emerald-950/20 hover:bg-emerald-500 hover:shadow-emerald-900/30 transition-all duration-300 active:scale-95 cursor-pointer"
    aria-label="Buka Konsultasi WhatsApp"
    aria-expanded="false"
  >
    {/* WhatsApp SVG Icon */}
    <svg class="h-6 w-6 fill-current transition-transform duration-300 group-hover:scale-110" viewBox="0 0 24 24">
      <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z" />
    </svg>
    <span class="text-sm font-semibold tracking-wide hidden sm:inline-block">
      Konsultasi WhatsApp
    </span>
  </button>
</div>

<script>
  function setupWhatsAppFloating() {
    const toggleBtn = document.getElementById("wa-toggle-btn");
    const popup = document.getElementById("wa-popup");
    const closeBtn = document.getElementById("wa-close-btn");
    const container = document.getElementById("wa-floating-container");

    if (!toggleBtn || !popup) return;

    function openPopup() {
      popup?.classList.remove("hidden");
      toggleBtn?.setAttribute("aria-expanded", "true");
    }

    function closePopup() {
      popup?.classList.add("hidden");
      toggleBtn?.setAttribute("aria-expanded", "false");
    }

    toggleBtn.onclick = (e) => {
      e.stopPropagation();
      const isHidden = popup.classList.contains("hidden");
      if (isHidden) {
        openPopup();
      } else {
        closePopup();
      }
    };

    if (closeBtn) {
      closeBtn.onclick = (e) => {
        e.stopPropagation();
        closePopup();
      };
    }

    // Close when clicking outside
    document.onclick = (e) => {
      if (container && !container.contains(e.target as Node)) {
        closePopup();
      }
    };

    // Close on Escape key
    document.onkeydown = (e) => {
      if (e.key === "Escape") {
        closePopup();
      }
    };
  }

  // Attach immediately
  setupWhatsAppFloating();
  document.addEventListener("DOMContentLoaded", setupWhatsAppFloating);
  document.addEventListener("astro:page-load", setupWhatsAppFloating);
</script>
