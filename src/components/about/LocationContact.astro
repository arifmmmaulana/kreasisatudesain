---
import { companyData } from "@/data/company";
import { getWhatsAppUrl } from "@/lib/whatsapp";

const waUrl = getWhatsAppUrl("Halo Kreasi Satu Desain, saya ingin berdiskusi mengenai proyek arsitektur/konstruksi.");
---

<section class="py-24 bg-white border-b border-stone-200">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-2xl mx-auto mb-12">
      <h2 class="text-3xl sm:text-4xl font-bold text-stone-900 font-display tracking-tight">
        Alamat & Kontak Kami
      </h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {/* 1. Alamat */}
      <div class="p-6 sm:p-7 rounded-2xl bg-stone-50 border border-stone-200 flex flex-col justify-between">
        <div>
          <h3 class="text-base font-bold text-stone-900 mb-2">Alamat</h3>
          <p class="text-sm text-stone-600 leading-relaxed mb-4">
            {companyData.contact.address}
          </p>
        </div>
        <div>
          <a
            href={companyData.contact.googleMapsUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center text-xs font-semibold text-brand hover:text-brand-dark transition-colors"
          >
            Buka di Google Maps →
          </a>
        </div>
      </div>

      {/* 2. WhatsApp & Telepon */}
      <div class="p-6 sm:p-7 rounded-2xl bg-stone-50 border border-stone-200 flex flex-col justify-between">
        <div>
          <h3 class="text-base font-bold text-stone-900 mb-2">WhatsApp & Telepon</h3>
          <p class="text-sm text-stone-600 font-medium mb-4">
            {companyData.contact.phone}
          </p>
        </div>
        <div>
          <a
            href={waUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center rounded-xl bg-emerald-600 px-4 py-2.5 text-xs font-semibold text-white hover:bg-emerald-700 transition shadow-sm"
          >
            Chat WhatsApp Sekarang
          </a>
        </div>
      </div>

      {/* 3. Email Resmi */}
      <div class="p-6 sm:p-7 rounded-2xl bg-stone-50 border border-stone-200 flex flex-col justify-between">
        <div>
          <h3 class="text-base font-bold text-stone-900 mb-2">Email Resmi</h3>
          <p class="text-sm text-stone-600 mb-4">
            Untuk pengiriman dokumen, penawaran, atau korespondensi resmi:
          </p>
        </div>
        <div>
          <a
            href={`mailto:${companyData.contact.email}`}
            class="text-sm font-semibold text-brand hover:text-brand-dark transition-colors break-all"
          >
            {companyData.contact.email}
          </a>
        </div>
      </div>

      {/* 4. Jam Operasional */}
      <div class="p-6 sm:p-7 rounded-2xl bg-stone-50 border border-stone-200 flex flex-col justify-between">
        <div>
          <h3 class="text-base font-bold text-stone-900 mb-2">Jam Operasional</h3>
          <p class="text-sm text-stone-600 mb-4">
            Waktu operasional studio dan layanan konsultasi kami:
          </p>
        </div>
        <div>
          <p class="text-sm font-semibold text-stone-900">
            {companyData.contact.workingHours}
          </p>
        </div>
      </div>
    </div>
  </div>
</section>
