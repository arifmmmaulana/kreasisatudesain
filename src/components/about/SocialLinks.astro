---
import { companyData } from "@/data/company";
---

<section class="py-20 bg-brand-warm">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    <h2 class="text-3xl sm:text-4xl font-bold font-display tracking-tight text-stone-900 mb-4">
      Sosial Media Resmi
    </h2>

    <p class="text-stone-600 text-sm sm:text-base max-w-xl mx-auto font-light leading-relaxed mb-12">
      Ikuti perjalanan kreasi desain, dokumentasi pengerjaan proyek konstruksi, dan tips arsitektur terkini dari Kreasi Satu Desain.
    </p>

    <div class="flex flex-wrap items-center justify-center gap-6 max-w-2xl mx-auto">
      {/* Instagram Card */}
      <a
        href={companyData.contact.instagram}
        target="_blank"
        rel="noopener noreferrer"
        class="group flex items-center gap-4 rounded-2xl bg-white border border-stone-200 p-5 px-7 hover:border-pink-300 hover:shadow-lg transition-all duration-300"
      >
        <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-gradient-to-tr from-amber-500 via-pink-500 to-purple-500 text-white shrink-0 group-hover:scale-110 transition-transform">
          <svg class="h-6 w-6 fill-current" viewBox="0 0 24 24">
            <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
          </svg>
        </div>
        <div class="text-left">
          <p class="text-xs text-stone-500">Ikuti di Instagram</p>
          <h4 class="text-base font-bold text-stone-900 group-hover:text-pink-500 transition-colors">
            {companyData.contact.instagramHandle}
          </h4>
        </div>
      </a>
    </div>
  </div>
</section>
