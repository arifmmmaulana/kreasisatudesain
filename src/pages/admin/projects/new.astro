---
export const prerender = false;
import AdminLayout from '@/layouts/AdminLayout.astro';
---

<AdminLayout title="Tambah Proyek">
  <h1>Tambah Proyek Baru</h1>
  <div class="card">
    <form id="project-form">
      <div class="grid grid-2">
        <div class="form-group">
          <label for="title">Judul</label>
          <input id="title" name="title" type="text" required />
        </div>
        <div class="form-group">
          <label for="category">Kategori</label>
          <select id="category" name="category">
            <option value="Rumah Tinggal">Rumah Tinggal</option>
            <option value="Komersial">Komersial</option>
            <option value="Interior">Interior</option>
            <option value="Renovasi">Renovasi</option>
          </select>
        </div>
      </div>
      <div class="form-group">
        <label for="location">Lokasi</label>
        <input id="location" name="location" type="text" required />
      </div>
      <div class="grid grid-2">
        <div class="form-group">
          <label for="year">Tahun</label>
          <input id="year" name="year" type="text" required />
        </div>
        <div class="form-group">
          <label for="coverImage">Cover Image URL</label>
          <input id="coverImage" name="coverImage" type="text" placeholder="/images/r2/..." required />
        </div>
      </div>
      <div class="form-group">
        <label for="description">Deskripsi</label>
        <textarea id="description" name="description"></textarea>
      </div>
      <div class="form-group">
        <label for="highlights">Highlights (pisah dengan koma)</label>
        <input id="highlights" name="highlights" type="text" placeholder="Modern, Elegan, ..." />
      </div>
      <div style="display: flex; gap: 1rem;">
        <button type="submit" class="btn btn-primary">Simpan</button>
        <a href="/admin/projects" class="btn btn-ghost">Batal</a>
      </div>
      <div id="error" class="alert alert-error" style="display:none; margin-top: 1rem;"></div>
    </form>
  </div>
</AdminLayout>

<script>
  document.getElementById('project-form')!.addEventListener('submit', async (e) => {
    e.preventDefault();
    const fd = new FormData(e.target as HTMLFormElement);
    const body = {
      title: fd.get('title'),
      category: fd.get('category'),
      location: fd.get('location'),
      year: fd.get('year'),
      cover_image: (fd.get('coverImage') as string).trim(),
      description: fd.get('description') || '',
      highlights: JSON.stringify(fd.get('highlights')?.toString().split(',').map((s: string) => s.trim()).filter(Boolean) ?? []),
    };
    const res = await fetch('/api/projects', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) });
    if (res.ok) { window.location.href = '/admin/projects'; }
    else { const d = await res.json(); (document.getElementById('error') as HTMLElement).style.display = 'block'; (document.getElementById('error') as HTMLElement).textContent = d.error || 'Gagal menyimpan'; }
  });
</script>
