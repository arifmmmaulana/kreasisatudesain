---
interface Props {
  title?: string;
}
const { title = 'Admin Panel' } = Astro.props;
---

<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} — Kreasi Satu Desain</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <style>
      @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300..800&display=swap');
      * { margin: 0; padding: 0; box-sizing: border-box; }
      body { font-family: 'Plus Jakarta Sans', system-ui, sans-serif; background: #fafaf9; color: #1c1917; min-height: 100vh; }
      nav { background: white; border-bottom: 1px solid #e7e5e4; padding: 0.75rem 2rem; display: flex; align-items: center; justify-content: space-between; }
      nav .brand { font-weight: 700; font-size: 1rem; color: #4A6380; }
      nav .links { display: flex; gap: 1.5rem; align-items: center; }
      nav a { text-decoration: none; color: #57534e; font-size: 0.875rem; font-weight: 500; }
      nav a:hover { color: #6B82A8; }
      nav button { background: none; border: 1px solid #d6d3d1; border-radius: .5rem; padding: .375rem 1rem; font-size: .8rem; cursor: pointer; color: #78716c; }
      nav button:hover { background: #f5f5f4; }
      main { max-width: 1400px; margin: 0 auto; padding: 2rem; }
      table { width: 100%; border-collapse: collapse; background: white; border: 1px solid #e7e5e4; border-radius: .75rem; overflow: hidden; }
      th { text-align: left; padding: .75rem 1rem; font-size: .75rem; text-transform: uppercase; letter-spacing: .05em; color: #78716c; background: #fafaf9; border-bottom: 1px solid #e7e5e4; }
      td { padding: .75rem 1rem; border-bottom: 1px solid #f5f5f4; font-size: .875rem; }
      tr:last-child td { border-bottom: none; }
      .btn { display: inline-flex; align-items: center; gap: .375rem; padding: .5rem 1rem; border-radius: .5rem; font-size: .8rem; font-weight: 600; text-decoration: none; cursor: pointer; border: none; transition: all .15s; }
      .btn-primary { background: #6B82A8; color: white; }
      .btn-primary:hover { background: #4A6380; }
      .btn-danger { background: #fef2f2; color: #dc2626; border: 1px solid #fecaca; }
      .btn-danger:hover { background: #fee2e2; }
      .btn-ghost { background: #f5f5f4; color: #57534e; }
      .btn-ghost:hover { background: #e7e5e4; }
      .badge { display: inline-block; padding: .25rem .625rem; border-radius: .375rem; font-size: .7rem; font-weight: 600; background: #E8EDF4; color: #4A6380; }
      .form-group { margin-bottom: 1.25rem; }
      .form-group label { display: block; font-size: .75rem; font-weight: 600; color: #44403c; margin-bottom: .375rem; text-transform: uppercase; letter-spacing: .05em; }
      .form-group input, .form-group select, .form-group textarea { width: 100%; padding: .625rem .75rem; border: 1px solid #d6d3d1; border-radius: .5rem; font-size: .875rem; background: white; box-sizing: border-box; }
      .form-group textarea { min-height: 100px; resize: vertical; }
      .card { background: white; border: 1px solid #e7e5e4; border-radius: .75rem; padding: 2rem; }
      h1 { font-size: 1.5rem; font-weight: 700; margin-bottom: 1.5rem; }
      h2 { font-size: 1.25rem; font-weight: 600; margin-bottom: 1rem; }
      .grid { display: grid; gap: 1rem; }
      .grid-2 { grid-template-columns: 1fr 1fr; }
      .stat-card { background: white; border: 1px solid #e7e5e4; border-radius: .75rem; padding: 1.5rem; text-align: center; }
      .stat-card .number { font-size: 2.5rem; font-weight: 800; color: #6B82A8; }
      .stat-card .label { font-size: .8rem; color: #78716c; margin-top: .25rem; }
      .actions { display: flex; gap: .5rem; }
      .alert { padding: 1rem; border-radius: .5rem; margin-bottom: 1rem; font-size: .875rem; }
      .alert-success { background: #f0fdf4; color: #166534; border: 1px solid #bbf7d0; }
      .alert-error { background: #fef2f2; color: #991b1b; border: 1px solid #fecaca; }
    </style>
  </head>
  <body>
    <nav>
      <span class="brand">KSD Admin</span>
      <div class="links">
        <a href="/admin">Dashboard</a>
        <a href="/admin/projects">Projects</a>
        <a href="/" target="_blank">Lihat Website</a>
        <button id="logout-btn">Logout</button>
      </div>
    </nav>
    <main>
      <slot />
    </main>
    <script>
      document.getElementById('logout-btn')?.addEventListener('click', async () => {
        await fetch('/api/auth/logout', { method: 'POST' });
        window.location.href = '/admin/login';
      });
    </script>
  </body>
</html>
